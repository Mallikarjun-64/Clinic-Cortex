# Server Configuration
PORT=5000
NODE_ENV=development

# Database Settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cliniccortex_db
DB_USER=postgres
DB_PASSWORD=postgres

# JWT Configurations
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Allowed Cross-Origin Origins (comma-separated list for production)
FRONTEND_URL=http://localhost:5173,http://localhost:5174


# =========================================================================
# REAL RAZORPAY PAYMENT GATEWAY & AUTOMATED DOCTOR BANK PAYOUT KEYS
# Obtain these from your Razorpay Merchant Dashboard: https://dashboard.razorpay.com/app/keys
# =========================================================================
# 1. Razorpay API Key ID (Starts with rzp_live_... or rzp_test_...)
RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID

# 2. Razorpay API Secret (Secret key corresponding to your Key ID)
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET

# 3. Razorpay Webhook Secret (For async transaction confirmation)
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET
